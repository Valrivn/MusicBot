# Voxaria Orchestrator Port
PORT=3001

# Orchestrator API Auth Key
ORCHESTRATOR_API_KEY=your_orchestrator_api_key_here
NODE_ENV=production

# Model Provider Endpoints (optional overrides)
# OPENCODE_API_URL=http://localhost:3000/api
# ANTIGRAVITY_API_URL=https://antigravity.google/api

# Parallel Worker Pool
MAX_WORKERS=10
POOL_SIZE=5

# Enable telemetry opt-out for skills CLI
# DISABLE_TELEMETRY=1
