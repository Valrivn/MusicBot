{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "dockerfile",
    "dockerfilePath": "MusicBot/Dockerfile"
  },
  "deploy": {
    "healthcheckPath": "/health/live",
    "healthcheckTimeout": 300,
    "restartPolicyType": "on_failure",
    "restartPolicyMaxRetries": 10
  },
  "services": {
    "web": {
      "name": "musicbot-web",
      "dockerfilePath": "MusicBot/Dockerfile",
      "startCommand": "npm start",
      "healthcheckPath": "/health/live",
      "healthcheckTimeout": 300
    },
    "worker": {
      "name": "karaoke-worker",
      "dockerfilePath": "MusicBot/Dockerfile",
      "startCommand": "npm run worker:karaoke",
      "healthcheckPath": "/health/live",
      "healthcheckTimeout": 300
    }
  },
  "plugins": {
    "redis": {
      "name": "musicbot-redis",
      "plan": "hobby"
    }
  },
  "volumes": {
    "voxaria-data": {
      "name": "voxaria-data",
      "mountPath": "/app/data",
      "size": "1GB"
    }
  }
}