# =============================================================================
# Voxaria-Web - Production Environment Template
# =============================================================================
# COPY THIS FILE TO .env AND FILL IN ALL VALUES BEFORE DEPLOYING
# NEVER COMMIT THE ACTUAL .env FILE WITH REAL SECRETS
# ALL VITE_* VARIABLES ARE EXPOSED TO THE BROWSER - NO SECRETS HERE!
# =============================================================================

# -----------------------------------------------------------------------------
# API Configuration (MusicBot Backend)
# -----------------------------------------------------------------------------
VITE_API_URL=https://your-production-api-domain.com
VITE_TRPC_URL=https://your-production-api-domain.com/api/trpc

# -----------------------------------------------------------------------------
# Discord OAuth Configuration (REQUIRED)
# -----------------------------------------------------------------------------
# Must match DISCORD_CLIENT_ID from MusicBot .env
VITE_DISCORD_CLIENT_ID=
# Must match Discord Developer Portal > OAuth2 > Redirects
# Format: https://voxaria.lovable.app/auth/callback (Lovable production)
VITE_DISCORD_REDIRECT_URI=https://voxaria.lovable.app/auth/callback
VITE_DISCORD_SCOPES=identify guilds guilds.members.read email

# -----------------------------------------------------------------------------
# Supabase Configuration (REQUIRED)
# -----------------------------------------------------------------------------
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# -----------------------------------------------------------------------------
# Feature Flags
# -----------------------------------------------------------------------------
VITE_ENABLE_KARAOKE=true
VITE_ENABLE_PLAYLISTS=true
VITE_ENABLE_LYRICS=true
VITE_ENABLE_QUEUE=true
VITE_ENABLE_SETTINGS=true
VITE_ENABLE_DEVTOOLS=false

# -----------------------------------------------------------------------------
# UI / Branding Configuration
# -----------------------------------------------------------------------------
VITE_APP_NAME=Voxaria
VITE_APP_DESCRIPTION=Discord music bot with karaoke, playlists, and more
VITE_DEFAULT_THEME=system
VITE_PRIMARY_COLOR=#FF6B6B

# -----------------------------------------------------------------------------
# Analytics / Monitoring (Optional)
# -----------------------------------------------------------------------------
# VITE_ANALYTICS_ID=
# VITE_SENTRY_DSN=

# -----------------------------------------------------------------------------
# WebSocket Configuration
# -----------------------------------------------------------------------------
VITE_WS_URL=wss://your-production-api-domain.com
VITE_ENABLE_WEBSOCKET=true